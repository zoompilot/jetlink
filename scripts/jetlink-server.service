# systemd unit for the Jetlink server container. install.sh installs it, with
# the launcher it runs (scripts/jetlink-run-server, as
# /usr/local/lib/jetlink/run-server) and /etc/jetlink/server.env, which says
# which image to run and how. Everything about the docker command line lives in
# the launcher, so this file is the same on every platform.
#
# By hand, after writing server.env (JETLINK_IMAGE at least):
#   sudo install -D -m 755 scripts/jetlink-run-server /usr/local/lib/jetlink/run-server
#   sudo install -m 644 scripts/jetlink-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now jetlink-server
#
# The Jetson is the USB host, so there is nothing to set up on this side beyond
# /dev/bus/usb; the comma runs the gadget (docs/transport.md).
[Unit]
Description=Jetlink inference server
After=docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=5
# a container left behind by a crash or a reboot holds the name
ExecStartPre=-/usr/bin/docker rm -f jetlink
ExecStart=/usr/local/lib/jetlink/run-server
ExecStop=/usr/bin/docker stop jetlink

[Install]
WantedBy=multi-user.target
