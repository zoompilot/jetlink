# jetlink: let a USB hub wake this box when the comma presents its gadget.
# Install:
#   sudo install -m 644 scripts/99-jetlink-usb-wakeup.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=usb --action=add
# Check: every /sys/bus/usb/devices/*/power/wakeup on a hub reads "enabled".
#
# The gadget hangs off the onboard Realtek hub, which has to signal a connect up
# before the root hub and the controller see it. tegra-xusb and both root hubs
# ship with wakeup enabled; the SuperSpeed hub (2-1, 0bda:0489) ships disabled,
# and at SuperSpeed it is the one in our path.
#
# Every hub, because which one carries us depends on the negotiated speed: at
# 480 Mbps it is 1-2, which happens to ship enabled.
ACTION=="add", SUBSYSTEM=="usb", ATTR{bDeviceClass}=="09", ATTR{power/wakeup}="enabled"
