+# -- the iPhone's link ----------------------------------------------------
+# An iPhone gives apps no USB access, so it cannot enumerate jetlink's
+# FunctionFS gadget. Instead the comma presents itself as a USB network
+# adapter (net_gadget.sh, CDC-NCM) at 192.168.60.1 and reaches the phone at
+# IPHONE_ENDPOINT over TCP. The models panel's "Accelerator on iPhone" toggle
+# writes or clears that endpoint; the owner brings the port to match.
+IPHONE_ENDPOINT = "192.168.60.2:5599"
+IPHONE_SUBNET = "192.168.60."
+NET_GADGET_PATH = Path("/sys/kernel/config/usb_gadget/jetlink-net")
+
+
+def iphone_link() -> bool:
+  """Is the endpoint one the comma's USB network adapter reaches? Another
+  endpoint, a Jetson on ethernet say, needs no adapter of ours."""
+  endpoint = link_endpoint()
+  return endpoint is not None and endpoint[0].startswith(IPHONE_SUBNET)
+
+
+def net_gadget_up() -> bool:
+  """Is the USB network adapter bound to the controller?"""
+  try:
+    return bool((NET_GADGET_PATH / "UDC").read_text().strip())
+  except OSError:
+    return False
+
+
+def _net_gadget_script() -> Path:
+  return Path(__file__).with_name('net_gadget.sh')
+
+
+def set_net_gadget(up: bool) -> bool:
+  """Present the USB network adapter, or take it down. Presenting it releases
+  jetlink's own gadget first and clears the error that release leaves in
+  GADGET_STATUS; taking it down leaves the port free for setup_gadget()."""
+  if not AGNOS:
+    return False
+  cmd = ['sudo', '-n', 'bash', str(_net_gadget_script())] + ([] if up else ['--teardown'])
+  try:
+    subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+                   timeout=GADGET_SETUP_TIMEOUT)
+  except Exception:
+    log.exception("jetlink: could not %s the USB network adapter", "present" if up else "remove")
+    return False
+  log.warning("jetlink: USB network adapter %s", "presented for the iPhone" if up else "removed")
+  return net_gadget_up() == up
+
